#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
command_name="${1:-help}"
case "$command_name" in
  verify) mvn -B --no-transfer-progress verify; (cd dashboard-frontend && flutter pub get && flutter analyze && flutter test) ;;
  up) docker compose --env-file secrets.env up --build -d ;;
  down) docker compose --env-file secrets.env down ;;
  runtime) mvn -pl productfactory -am spring-boot:run ;;
  dashboard) mvn -pl dashboard-backend -am spring-boot:run ;;
  agent-worker) exec ./agentworker-loop.sh ;;
  agent-worker-once) mvn -q -DskipTests -pl productfactory-contracts,productfactory-common install && exec mvn -pl agentworker spring-boot:run ;;
  agent-worker-install) exec ./tools/agent-worker-launchagent install ;;
  agent-worker-restart) exec ./tools/agent-worker-launchagent restart ;;
  agent-worker-status) exec ./tools/agent-worker-launchagent status ;;
  agent-worker-uninstall) exec ./tools/agent-worker-launchagent uninstall ;;
  *) echo "Gebruik: ./product-factory {verify|up|down|runtime|dashboard|agent-worker|agent-worker-once|agent-worker-install|agent-worker-restart|agent-worker-status|agent-worker-uninstall}" ;;
esac
