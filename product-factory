#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

use_java_21() {
  if [[ "$(uname -s)" == "Darwin" ]] && [[ -x /usr/libexec/java_home ]]; then
    export JAVA_HOME="$(/usr/libexec/java_home -v 21)"
    export PATH="$JAVA_HOME/bin:$PATH"
  fi
  java_major="$(java -version 2>&1 | awk -F '[\".]' '/version/ {print $2; exit}')"
  if [[ "$java_major" != "21" ]]; then
    echo "Error: Product Factory vereist Java 21; gevonden hoofdversie ${java_major:-onbekend}." >&2
    exit 1
  fi
}

case "${1:-help}" in
  verify)
    use_java_21
    tools/audit-mvp-specifications.sh
    mvn -B --no-transfer-progress verify
    (cd product-factory-frontend && flutter pub get && flutter analyze && flutter test)
    tools/build-frontend.sh
    ;;
  backend)
    use_java_21
    export PF_DB_URL="jdbc:postgresql://localhost:5436/productfactory_v2"
    export PF_DB_USERNAME="productfactory_v2"
    exec mvn -pl product-factory-app -am spring-boot:run
    ;;
  frontend)
    cd product-factory-frontend
    exec flutter run -d chrome --web-port 8082
    ;;
  cache-test)
    exec tools/test-frontend-cache.sh
    ;;
  deploy-test)
    exec tools/verify-deployment.sh
    ;;
  up)
    "$0" verify
    exec docker compose --env-file "$ROOT/secrets.env" up -d
    ;;
  down)
    exec docker compose --env-file "$ROOT/secrets.env" down
    ;;
  *)
    echo "Gebruik: ./product-factory {verify|backend|frontend|cache-test|deploy-test|up|down}"
    ;;
esac
