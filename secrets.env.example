# Kopieer alleen voor lokale ontwikkeling naar secrets.env. Commit nooit echte waarden.

# Productiedatabase. Gebruik per omgeving een afzonderlijke gebruiker en credential.
PF_DB_URL=jdbc:postgresql://localhost:5436/productfactory_v2
PF_DB_USERNAME=productfactory_v2
PF_DB_PASSWORD=change-me-locally

# Productieauthenticatie. Lokale ontwikkeling en acceptatie zetten auth expliciet uit.
PF_GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
PF_STAKEHOLDER_EMAILS=stakeholder@example.invalid
PF_SESSION_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Agent Runtime-consument. Alleen acceptatie/integratietests mogen daarnaast een afzonderlijk
# gescopete test-controlcredential gebruiken; gebruik nooit een admin- of workercredential.
PF_AGENT_RUNTIME_URL=http://localhost:8081
PF_AGENT_RUNTIME_TOKEN=
PF_AGENT_RUNTIME_TEST_CONTROL_TOKEN=

# Gereserveerd voor Software Factory-dispatching in stap 8.
PF_SOFTWARE_FACTORY_TOKEN=
