# Kopieer naar secrets.env. Commit secrets.env nooit.
PF_DB_PASSWORD=choose-a-local-password
# Fijnmazig token: Contents en Pull requests write, uitsluitend product-factory-workspace.
PF_WORKSPACE_GITHUB_TOKEN=
# OAuth-client-id is niet geheim, maar staat hier naast de bijbehorende lokale authconfiguratie.
PF_GOOGLE_CLIENT_ID=
# Komma-gescheiden, expliciete beheerdersallowlist.
PF_ADMIN_EMAILS=
# Willekeurig apart token voor de uitgaande Mac-agentworkerverbinding, bijvoorbeeld `openssl rand -hex 32`.
PF_AGENT_WORKER_TOKEN=
PF_SOFTWARE_FACTORY_TOKEN=
# Ondertekent (HMAC) het eigen, 30 dagen geldige dashboardsessie-token dat na een Google-login wordt
# afgegeven, los van Google's eigen 1-uurslimiet op het ID-token. Bijvoorbeeld `openssl rand -hex 32`.
PF_DASHBOARD_REMEMBER_SECRET=
