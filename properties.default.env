# Niet-geheime Product Factory-defaults. Proces-environmentvariabelen hebben voorrang.
PF_DB_URL=jdbc:postgresql://localhost:5436/productfactory
PF_DB_USERNAME=productfactory
PF_RUNTIME_PORT=8080
PF_DASHBOARD_BACKEND_PORT=8081
PF_RUNTIME_BASE_URL=http://localhost:8080
PF_WORKSPACE_PATH=../product-factory-workspace
PF_WORKSPACE_REPOSITORY=git@github.com:robbertvdzon/product-factory-workspace.git
PF_WORKSPACE_MAIN_BRANCH=main
PF_WORKSPACE_REMOTE_PUBLICATION=false
PF_DASHBOARD_AUTH_REQUIRED=false
PF_BUILD_SHA=development
