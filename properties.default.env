# Commitbare, niet-geheime lokale defaults. Proces-environmentvariabelen hebben voorrang.
PF_ENVIRONMENT=local
PF_BACKEND_PORT=8080
PF_PUBLIC_FRONTEND_URL=http://localhost:8082
PF_PUBLIC_BACKEND_URL=http://localhost:8080
PF_AUTH_REQUIRED=false
PF_SCHEDULES_ENABLED=false
PF_AI_PROVIDER=DISABLED
PF_SOFTWARE_FACTORY_MODE=DISABLED
PF_EXTERNAL_MUTATIONS_ALLOWED=false
PF_APPLICATION_VERSION=0.1.0
PF_GIT_REVISION=
PF_BUILD_TIME=
PF_DB_URL=jdbc:postgresql://localhost:5436/productfactory_v2
PF_DB_USERNAME=productfactory_v2
