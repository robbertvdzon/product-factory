<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>
    <groupId>nl.vdzon</groupId>
    <artifactId>product-factory-root</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.1.21</kotlin.version>
        <spring-modulith.version>1.4.11</spring-modulith.version>
    </properties>
    <dependencyManagement><dependencies>
        <dependency><groupId>nl.vdzon</groupId><artifactId>productfactory-contracts</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>nl.vdzon</groupId><artifactId>productfactory-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.modulith</groupId><artifactId>spring-modulith-bom</artifactId><version>${spring-modulith.version}</version><type>pom</type><scope>import</scope></dependency>
    </dependencies></dependencyManagement>
    <modules>
        <module>productfactory-contracts</module>
        <module>productfactory-common</module>
        <module>productfactory</module>
        <module>agentworker</module>
        <module>dashboard-backend</module>
    </modules>
    <profiles><profile><id>quality</id><build><plugins><plugin>
        <groupId>com.github.ozsie</groupId><artifactId>detekt-maven-plugin</artifactId><version>1.23.7</version>
        <configuration><input>${project.basedir}/src/main/kotlin</input><config>${maven.multiModuleProjectDirectory}/quality/detekt.yml</config><buildUponDefaultConfig>true</buildUponDefaultConfig></configuration>
    </plugin></plugins></build></profile></profiles>
</project>
