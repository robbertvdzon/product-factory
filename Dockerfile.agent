FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY productfactory-contracts productfactory-contracts
COPY productfactory-common productfactory-common
COPY agentworker agentworker
COPY productfactory/pom.xml productfactory/pom.xml
COPY dashboard-backend/pom.xml dashboard-backend/pom.xml
RUN mvn -B --no-transfer-progress -pl agentworker -am package -DskipTests
FROM eclipse-temurin:21-jre
RUN useradd --uid 10001 --create-home agentworker \
 && chgrp -R 0 /home/agentworker \
 && chmod -R g=u /home/agentworker
USER 10001
WORKDIR /home/agentworker
COPY --from=build /src/agentworker/target/productfactory-agentworker-*.jar /app.jar
ENTRYPOINT ["java","-jar","/app.jar"]
